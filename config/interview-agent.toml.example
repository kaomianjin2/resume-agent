[llm]
base_url = "https://your-openai-compatible-endpoint/v1"
api_key = "your-key"
model = "your-model"

[embedding]
provider = "your-embedding-provider"
model_name = "your-embedding-model-name"
model_path = "./path/to/your-embedding-model"

[storage]
database_path = "./path/to/your-database.sqlite"

[knowledge_base]
source = "/path/to/your-knowledge-base-source"
chunk_size = 0
chunk_overlap = 0
top_k = 0
index_version = "your-index-version"
