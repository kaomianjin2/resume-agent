{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interview Agent",
  "version": "0.1.0",
  "identifier": "com.interviewagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Interview Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": []
  }
}
